# Copiez ce fichier en ".env" puis remplissez les valeurs.
# Ne publiez JAMAIS le fichier .env (il est ignoré par git).

# Base PostgreSQL (locale ou hébergée : Neon, Supabase...)
# Caractères spéciaux du mot de passe à encoder : @ -> %40, ! -> %21, # -> %23
DATABASE_URL="postgresql://postgres:MOT_DE_PASSE@localhost:5432/pixelcoveille"

# Moteur IA principal (obligatoire pour noter les articles) : https://console.groq.com/keys
GROQ_API_KEY=""

# Moteur IA de secours si le quota Groq est épuisé (optionnel) : https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# URL publique du site (localhost en local, URL Vercel en production)
NEXTAUTH_URL="http://localhost:3000"
